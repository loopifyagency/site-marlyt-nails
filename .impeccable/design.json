  "narrative": {
    "northStar": "Le Nuancier",
    "overview": "Un présentoir de teintes de manucure, agrandi à l'échelle d'un site. Chaque section est une teinte posée à plat, chaque numéro cite le nuancier, et choisir un échantillon repeint la page. Le système est chaleureux et féminin sans être sucré : la couleur est franche, la typographie est ronde et épaisse comme un gel brillant, et les photos de vraies mains sont les seules images.\n\nLa densité est généreuse : grands aplats, titres géants, beaucoup d'air, puis un détail précis (une étiquette de teinte, une goutte de vernis). Le mouvement est une couche ajoutée : tout est lisible sans lui.",
    "keyCharacteristics": [
      "Aplats pleins de six teintes, jamais de dégradé entre sections.",
      "Trois formes d'ongle (ovale, carré, amande) comme seuls masques.",
      "Étiquettes de teinte numérotées (N°01 à N°07) comme signature récurrente.",
      "Coutures de sections en bords de vernis qui coule.",
      "Display épais et rond, texte neutre et précis."
    ],
    "rules": [
      {
        "name": "The One Shade Rule",
        "body": "Chaque section prend exactement une teinte de fond et en tire tous ses rôles (fond, encre, accent, surface douce). On change de teinte à la couture, jamais au milieu d'une section."
      },
      {
        "name": "The Shade Number Rule",
        "body": "Un « N° » cite toujours le nuancier : 01 Fuchsia, 02 Griotte miroir, 03 Dragée, 04 Cerise, 05 Givre, 06 Griotte, 07 Neige. Il ne numérote jamais des sections."
      },
      {
        "name": "The Tabular Tag Rule",
        "body": "Les numéros de teinte et les chiffres animés utilisent des chiffres tabulaires pour ne pas bouger pendant le comptage."
      },
      {
        "name": "The One Elevation Rule",
        "body": "Un élément porte soit une ombre, soit une bordure, jamais les deux. Aucune ombre dure ni halo coloré."
      },
      {
        "name": "The Lacquer Seam Rule",
        "body": "Une section en recouvre la suivante par un bord de gouttes dans sa propre teinte. Pas de séparateur droit."
      }
    ],
    "dos": [
      "Do donner à chaque section une teinte pleine et en dériver tous les rôles (fond, encre, accent).",
      "Do garder tout texte à 4,5:1 au moins ; vérifié pour chaque paire teinte/encre.",
      "Do animer seulement `transform`, `opacity`, `clip-path` ; courbes ease-out fortes (`cubic-bezier(0.23, 1, 0.32, 1)`).",
      "Do prévoir une version calme : `prefers-reduced-motion` supprime scroll lissé, pins, loader et marquee défilant."
    ],
    "donts": [
      "Don't utiliser de crème, de beige ou de noir pur : le clair est le blanc neige rosé, le sombre est la griotte.",
      "Don't utiliser un serif fin à fort contraste ni une écriture cursive pour le display.",
      "Don't poser de dégradé de fond ni de texte en dégradé.",
      "Don't numéroter des sections ni agrandir une photo au-delà de sa résolution utile.",
      "Don't inventer prix, chiffres, avis ou réseaux sociaux."
    ]
  }
}